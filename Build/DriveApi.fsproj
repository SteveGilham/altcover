<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="DriveApi.fs" />
	</ItemGroup>

	<ItemGroup>
		<!-- It writes the latest, but needs a valid version -->
		<PackageReference Include="AltCover.Api" VersionOverride="4.0.600" />
		<PackageReference Include="AltCover.Fake" VersionOverride="4.0.655" />
		<PackageReference Include="Fake.Core.Target" />
		<PackageReference Include="Fake.DotNet.Cli" />
		<PackageReference Include="System.Collections.Immutable" />
		<PackageReference Include="Unquote" />
	</ItemGroup>
</Project>